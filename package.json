{
  "name": "extract-io",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=20.12"
  },
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "dev": "pnpm --parallel --filter \"./apps/*\" dev",
    "dev:web": "pnpm --filter @extract/web dev",
    "dev:game": "pnpm --filter @extract/game-server dev",
    "dev:api": "pnpm --filter @extract/api dev",
    "dev:sandbox": "pnpm --filter @extract/game-server sandbox",
    "build": "pnpm -r build",
    "start": "pnpm --parallel --filter @extract/api --filter @extract/game-server start",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "db:generate": "pnpm --filter @extract/database generate",
    "db:migrate": "pnpm --filter @extract/database migrate:dev",
    "db:deploy": "pnpm --filter @extract/database migrate:deploy",
    "db:seed": "pnpm --filter @extract/database seed",
    "db:setup": "pnpm db:deploy && pnpm db:seed",
    "db:reset": "pnpm --filter @extract/database reset",
    "db:studio": "pnpm --filter @extract/database studio",
    "db:embedded": "node scripts/embedded-postgres.mjs",
    "bots": "pnpm --filter @extract/game-server bots",
    "loadtest": "pnpm --filter @extract/game-server loadtest"
  },
  "devDependencies": {
    "embedded-postgres": "18.4.0-beta.17",
    "typescript": "^5.9.2"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "prisma",
      "esbuild",
      "embedded-postgres",
      "@embedded-postgres/windows-x64",
      "@embedded-postgres/linux-x64",
      "@embedded-postgres/darwin-arm64",
      "@embedded-postgres/darwin-x64"
    ]
  }
}
