# ---------------------------------------------------------------------------
# EXTRACT.IO environment. Copy to `.env` (pnpm setup does this for you).
# Never commit real secrets.
# ---------------------------------------------------------------------------

NODE_ENV=development
LOG_LEVEL=info

# PostgreSQL (docker compose or `pnpm db:embedded`)
DATABASE_URL=postgresql://extract:extract@localhost:5432/extractio?schema=public
# Stops the Prisma CLI from phoning home (it can hang on restricted networks)
CHECKPOINT_DISABLE=1

# Reserved for multi-node matchmaking / presence. Not used by the MVP.
REDIS_URL=

# Shared between API (signs) and game server (verifies). Use a long random value in production.
JWT_SECRET=dev-only-secret-change-me-0123456789abcdef

# REST API
API_PORT=3001
API_URL=http://localhost:3001
CORS_ORIGIN=http://localhost:5173

# Game server (WebSocket at ws://<host>:<port>/ws)
GAME_SERVER_PORT=3002
GAME_SERVER_URL=ws://localhost:3002/ws

# Matchmaking: total players per match (humans + bots). Architecture supports up to 100.
MATCH_TARGET_PLAYERS=20
# Fill lobbies with bots (development)
MATCH_FILL_WITH_BOTS=true
# Humans needed to start a match when bots are disabled (1 = solo sandbox)
MATCH_MIN_HUMANS=2
# Seconds a lobby waits for humans before bots fill the remaining slots
LOBBY_WAIT_SECONDS=8

# Development tools (dev panel, /dev endpoints). Forced off when NODE_ENV=production.
DEV_TOOLS=true
# Allow WebSocket joins without an account token (load tests). Forced off in production.
ALLOW_ANONYMOUS_PLAY=true

# Blockchain provider: mock | solana (solana is a future stub)
BLOCKCHAIN_PROVIDER=mock
