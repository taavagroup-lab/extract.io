{
  "name": "@extract/game-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/index.ts",
    "start": "node dist/index.js",
    "build": "tsup",
    "typecheck": "tsc --noEmit -p .",
    "test": "vitest run",
    "bots": "tsx scripts/spawnBots.ts",
    "loadtest": "tsx scripts/loadtest.ts"
  },
  "dependencies": {
    "@extract/database": "workspace:*",
    "@extract/game-config": "workspace:*",
    "@extract/game-types": "workspace:*",
    "@extract/server-core": "workspace:*",
    "@extract/shared": "workspace:*",
    "@msgpack/msgpack": "^3.1.2",
    "@prisma/client": "^6.16.0",
    "jsonwebtoken": "^9.0.2",
    "pino": "^9.9.0",
    "pino-pretty": "^13.1.1",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "@types/ws": "^8.18.1",
    "tsup": "^8.5.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
